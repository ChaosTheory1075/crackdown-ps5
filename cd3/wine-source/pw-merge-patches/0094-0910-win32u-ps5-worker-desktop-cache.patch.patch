From 6c57f5ccf0ebe9819a5c37837a4b9dffd926a18e Mon Sep 17 00:00:00 2001
From: x <x@x>
Date: Thu, 5 Nov 2026 11:16:38 -0500
Subject: [PATCH 094/122] 0910-win32u-ps5-worker-desktop-cache.patch

---
 dlls/win32u/ntuser_private.h |  1 +
 dlls/win32u/win32u_private.h |  1 +
 dlls/win32u/window.c         | 10 ++++++++--
 dlls/win32u/winstation.c     | 30 +++++++++++++++++++++++++++++-
 4 files changed, 39 insertions(+), 3 deletions(-)

diff --git a/dlls/win32u/ntuser_private.h b/dlls/win32u/ntuser_private.h
index e40a657..a8a707e 100644
--- a/dlls/win32u/ntuser_private.h
+++ b/dlls/win32u/ntuser_private.h
@@ -132,6 +132,7 @@ struct user_thread_info
     BOOL                          clipping_cursor;        /* thread is currently clipping */
     DWORD                         clipping_reset;         /* time when clipping was last reset */
     struct session_thread_data   *session_data;           /* shared session thread data */
+    BOOL                          desktop_cache_only;     /* handles cached without USER initialization */
     struct mouse_tracking_info   *mouse_tracking_info;    /* NtUserTrackMouseEvent handling */
     struct opengl_thread_data    *opengl_data;            /* OpenGL private thread data */
     struct list                   known_pointers;         /* list of known pointers */
diff --git a/dlls/win32u/win32u_private.h b/dlls/win32u/win32u_private.h
index 94d074e..f44a52f 100644
--- a/dlls/win32u/win32u_private.h
+++ b/dlls/win32u/win32u_private.h
@@ -290,6 +290,7 @@ extern LRESULT destroy_window( HWND hwnd );
 extern BOOL get_client_rect( HWND hwnd, RECT *rect, struct ratio dpi );
 extern BOOL get_present_rect( HWND hwnd, RECT *rect, struct ratio dpi );
 extern HWND get_desktop_window(void);
+extern void cache_thread_desktop_windows(void);
 extern struct ratio get_dpi_for_window( HWND hwnd );
 extern HWND get_full_window_handle( HWND hwnd );
 extern HWND get_parent( HWND hwnd );
diff --git a/dlls/win32u/window.c b/dlls/win32u/window.c
index 8b12f0d..738df48 100644
--- a/dlls/win32u/window.c
+++ b/dlls/win32u/window.c
@@ -335,11 +335,12 @@ void detach_client_surfaces( HWND hwnd )
 static RECT get_client_surface_rects( HWND toplevel, HWND hwnd, RECT *monitor_rect )
 {
     struct ratio dpi = get_dpi_for_window( hwnd ), raw_dpi;
-    struct window_rects rects, monitor_rects;
+    struct window_rects rects = {0}, monitor_rects;
     RECT rect = {0};
 
+    SetRectEmpty( monitor_rect );
     if (!toplevel) toplevel = NtUserGetAncestor( hwnd, GA_ROOT );
-    get_window_rects( toplevel, COORDS_PARENT, &rects, dpi );
+    if (!toplevel || !get_window_rects( toplevel, COORDS_PARENT, &rects, dpi )) return rect;
     monitor_rects = map_window_rects_virt_to_raw( rects, dpi );
 
     if (get_present_rect( hwnd, &rect, dpi )) OffsetRect( &rect, -rects.client.left, -rects.client.top );
@@ -1020,6 +1021,11 @@ HWND WINAPI NtUserGetAncestor( HWND hwnd, UINT type )
         break;
 
     case GA_ROOT:
+#ifdef WINE_PS5_USER_DRIVER
+        /* Vulkan workers may never have entered USER initialization.  The
+         * server desktop has no local WND; recognize it before the walk. */
+        cache_thread_desktop_windows();
+#endif
         if (!(list = list_window_parents( hwnd ))) return 0;
 
         if (!list[0] || !list[1]) ret = get_full_window_handle( hwnd );  /* top-level window */
diff --git a/dlls/win32u/winstation.c b/dlls/win32u/winstation.c
index 40bed6e..4f3b42e 100644
--- a/dlls/win32u/winstation.c
+++ b/dlls/win32u/winstation.c
@@ -609,6 +609,7 @@ BOOL WINAPI NtUserSetThreadDesktop( HDESK handle )
         memset( &data->shared_foreground, 0, sizeof(data->shared_foreground) );
         thread_info->top_window = 0;
         thread_info->msg_window = 0;
+        thread_info->desktop_cache_only = FALSE;
         if (was_virtual_desktop != is_virtual_desktop()) update_display_cache( TRUE );
     }
     return ret;
@@ -816,12 +817,36 @@ static inline TEB64 *NtCurrentTeb64(void) { return NULL; }
 static inline TEB64 *NtCurrentTeb64(void) { return (TEB64 *)NtCurrentTeb()->GdiBatchCount; }
 #endif
 
+/* Query existing desktop handles only.  Unlike get_desktop_window(), this
+ * must not create windows, load a driver, or register builtin classes. */
+void cache_thread_desktop_windows(void)
+{
+    struct user_thread_info *thread_info = get_user_thread_info();
+
+    if (thread_info->top_window) return;
+    SERVER_START_REQ( get_desktop_window )
+    {
+        req->force = FALSE;
+        if (!wine_server_call( req ))
+        {
+            thread_info->top_window = wine_server_ptr_handle( reply->top_window );
+            thread_info->msg_window = wine_server_ptr_handle( reply->msg_window );
+            thread_info->desktop_cache_only = !!thread_info->top_window;
+        }
+    }
+    SERVER_END_REQ;
+}
+
 HWND get_desktop_window(void)
 {
     struct user_thread_info *thread_info = get_user_thread_info();
     BOOL is_service;
 
-    if (thread_info->top_window) return thread_info->top_window;
+    if (thread_info->top_window)
+    {
+        if (!thread_info->desktop_cache_only) return thread_info->top_window;
+        goto initialize;
+    }
 
     /* don't create an actual explorer desktop window for services */
     is_service = is_service_process();
@@ -929,6 +954,9 @@ HWND get_desktop_window(void)
         }
         SERVER_END_REQ;
     }
+initialize:
+    /* Mark before callbacks, matching the old top_window reentrancy guard. */
+    thread_info->desktop_cache_only = FALSE;
     if (!thread_info->top_window) ERR_(win)( "failed to create desktop window\n" );
     else user_driver->pSetDesktopWindow( thread_info->top_window );
 
-- 
