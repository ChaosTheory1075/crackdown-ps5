From 36fd45de0e08d9828c297476a04116ef5dc72bb6 Mon Sep 17 00:00:00 2001
From: local <local@localhost>
Date: Wed, 11 Nov 2026 14:46:45 -0500
Subject: [PATCH 120/122] kernelbase: LoadPackagedLibrary appends .dll to a
 name with no extension (Unreal GetDllHandle; Crackdown 3 Xbox Live Init)

---
 dlls/kernelbase/loader.c | 11 ++++++++++-
 1 file changed, 10 insertions(+), 1 deletion(-)

diff --git a/dlls/kernelbase/loader.c b/dlls/kernelbase/loader.c
index e1d1cd4..0f44e5d 100644
--- a/dlls/kernelbase/loader.c
+++ b/dlls/kernelbase/loader.c
@@ -617,7 +617,7 @@ HMODULE WINAPI /* DECLSPEC_HOTPATCH */ LoadPackagedLibrary( LPCWSTR name, DWORD
         SetLastError( err == ERROR_SUCCESS ? APPMODEL_ERROR_NO_PACKAGE : err );
         return NULL;
     }
-    if (!(path = HeapAlloc( GetProcessHeap(), 0, (len + 1 + wcslen( name ) + 1) * sizeof(WCHAR) )))
+    if (!(path = HeapAlloc( GetProcessHeap(), 0, (len + 1 + wcslen( name ) + 5) * sizeof(WCHAR) )))
     {
         SetLastError( ERROR_NOT_ENOUGH_MEMORY );
         return NULL;
@@ -631,6 +631,15 @@ HMODULE WINAPI /* DECLSPEC_HOTPATCH */ LoadPackagedLibrary( LPCWSTR name, DWORD
     lstrcatW( path, L"\\" );
     lstrcatW( path, name );
 
+    /* As LoadLibrary, a name with no extension means ".dll": Unreal's GetDllHandle passes
+     * "Engine/Plugins/.../cpprest141_uwp_2_9" (Crackdown 3's Xbox Live subsystem Init fails on it). */
+    if (GetFileAttributesW( path ) == INVALID_FILE_ATTRIBUTES)
+    {
+        const WCHAR *base = path, *p2;
+        for (p2 = path; *p2; p2++) if (*p2 == '\\' || *p2 == '/') base = p2 + 1;
+        if (!wcschr( base, '.' )) lstrcatW( path, L".dll" );
+    }
+
     if (GetFileAttributesW( path ) != INVALID_FILE_ATTRIBUTES)
         module = LoadLibraryExW( path, NULL, LOAD_WITH_ALTERED_SEARCH_PATH );
     else
