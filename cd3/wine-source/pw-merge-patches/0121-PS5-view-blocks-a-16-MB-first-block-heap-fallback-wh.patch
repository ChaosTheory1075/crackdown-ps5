From cb7fd7671e34283af70d05458e4e6b6d929c766d Mon Sep 17 00:00:00 2001
From: local <local@localhost>
Date: Wed, 11 Nov 2026 16:54:29 -0500
Subject: [PATCH 121/122] PS5: view blocks: a 16 MB first block, heap fallback
 when mmap has no room

---
 dlls/ntdll/unix/virtual.c | 19 +++++++++++++++++++
 1 file changed, 19 insertions(+)

diff --git a/dlls/ntdll/unix/virtual.c b/dlls/ntdll/unix/virtual.c
index 681645d..c14ed0b 100644
--- a/dlls/ntdll/unix/virtual.c
+++ b/dlls/ntdll/unix/virtual.c
@@ -1933,6 +1933,14 @@ static struct file_view *alloc_view(void)
     if (view_block_start == view_block_end)
     {
         void *ptr = anon_mmap_alloc( view_block_size, PROT_READ | PROT_WRITE );
+#ifdef __PROSPERO__
+        /* [cd3] A title that fills the top of the address space (Crackdown 3's UE4 pools) leaves the kernel no
+         * room for this mmap: every later VirtualAlloc then failed "out of memory for allocation" with direct
+         * memory to spare. Take the next block from the heap instead; view blocks are never freed. */
+        if (ptr == MAP_FAILED && (ptr = malloc( view_block_size ))) memset( ptr, 0, view_block_size );
+        else if (ptr == MAP_FAILED) ptr = MAP_FAILED;
+        if (!ptr) ptr = MAP_FAILED;
+#endif
         if (ptr == MAP_FAILED) return NULL;
         view_block_start = ptr;
         view_block_end = view_block_start + view_block_size / sizeof(*view_block_start);
@@ -4045,8 +4053,19 @@ void virtual_init(void)
     pages_vprot = anon_mmap_alloc( 1U << (32 - page_shift), PROT_READ | PROT_WRITE );
 #endif
     assert( pages_vprot != MAP_FAILED );
+#ifdef __PROSPERO__
+    /* [cd3] a first block for ~350k views, made while the address space still has room */
+    view_block_start = anon_mmap_alloc( 16 * view_block_size, PROT_READ | PROT_WRITE );
+    if (view_block_start == MAP_FAILED)
+        view_block_start = anon_mmap_alloc( view_block_size, PROT_READ | PROT_WRITE );
+    else
+        view_block_end = view_block_start + 16 * view_block_size / sizeof(*view_block_start);
+    if (view_block_start != MAP_FAILED && !view_block_end)
+        view_block_end = view_block_start + view_block_size / sizeof(*view_block_start);
+#else
     view_block_start = anon_mmap_alloc( view_block_size, PROT_READ | PROT_WRITE );
     view_block_end = view_block_start + view_block_size / sizeof(*view_block_start);
+#endif
     assert( view_block_start != MAP_FAILED );
     wine_rb_init( &views_tree, compare_view );
     kernel_writewatch_init();
