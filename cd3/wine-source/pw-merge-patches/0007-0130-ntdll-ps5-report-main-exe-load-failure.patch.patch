From 230f3c40666c5d3e1ebe1b49e2625cc05d906c42 Mon Sep 17 00:00:00 2001
From: x <x@x>
Date: Thu, 5 Nov 2026 11:16:33 -0500
Subject: [PATCH 007/122] 0130-ntdll-ps5-report-main-exe-load-failure.patch

---
 dlls/ntdll/unix/env.c | 32 ++++++++++++++++++++++++++++++++
 1 file changed, 32 insertions(+)

diff --git a/dlls/ntdll/unix/env.c b/dlls/ntdll/unix/env.c
index bd888b9..71c4376 100644
--- a/dlls/ntdll/unix/env.c
+++ b/dlls/ntdll/unix/env.c
@@ -1869,6 +1869,19 @@ static void init_peb( RTL_USER_PROCESS_PARAMETERS *params, BOOL debugged )
 }
 
 
+#ifdef __PROSPERO__
+/* End the process through exit(), so the host's exit handlers run: a PS5
+ * title restarts into its launcher from one. Terminating the other threads
+ * first marks the process as exiting; terminating itself straight away is
+ * abort_process, which is _exit(). */
+static void DECLSPEC_NORETURN exit_initial_process( NTSTATUS status )
+{
+    NtTerminateProcess( 0, status );
+    NtTerminateProcess( GetCurrentProcess(), status );
+    abort_process( status );
+}
+#endif
+
 /*************************************************************************
  *		build_initial_params
  *
@@ -1910,11 +1923,21 @@ static RTL_USER_PROCESS_PARAMETERS *build_initial_params(void)
 
     get_full_path( main_argv[1], curdir, &nt_name );
     status = load_main_exe( &nt_name, 0 );
+#ifdef __PROSPERO__
+    /* The title's own image may hold the program's preferred base, so the
+     * program is mapped elsewhere; the PE loader relocates it, as Windows
+     * does. start.exe would only retry in a new process, which a PS5 title
+     * cannot create. */
+    if (status == STATUS_IMAGE_NOT_AT_BASE) status = STATUS_SUCCESS;
+#endif
     /* fail only if the file contained an explicit path */
     if (status == STATUS_DLL_NOT_FOUND &&
         (strpbrk( main_argv[1], "/\\" ) || (main_argv[1][0] && main_argv[1][1] == ':')))
     {
         MESSAGE( "wine: failed to open %s\n", debugstr_a(main_argv[1]) );
+#ifdef __PROSPERO__
+        exit_initial_process( status );
+#endif
         NtTerminateProcess( GetCurrentProcess(), status );
     }
 
@@ -1931,6 +1954,15 @@ static RTL_USER_PROCESS_PARAMETERS *build_initial_params(void)
         }
     }
 
+#ifdef __PROSPERO__
+    /* start.exe would only run the program in a new process, which a PS5
+     * title cannot create: say why it cannot run in this one instead. */
+    if (status)
+    {
+        MESSAGE( "wine: cannot run %s in this process: status %08x\n", debugstr_a(main_argv[1]), status );
+        exit_initial_process( status );
+    }
+#endif
     if (status)  /* try launching it through start.exe */
     {
         static const char *args[] = { "start.exe", "/exec" };
-- 
