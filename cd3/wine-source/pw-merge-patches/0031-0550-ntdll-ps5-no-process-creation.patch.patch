From 41120754b79c4a35cfc94825a42e034766a06cef Mon Sep 17 00:00:00 2001
From: x <x@x>
Date: Thu, 5 Nov 2026 11:16:34 -0500
Subject: [PATCH 031/122] 0550-ntdll-ps5-no-process-creation.patch

---
 dlls/ntdll/unix/process.c | 11 +++++++++++
 1 file changed, 11 insertions(+)

diff --git a/dlls/ntdll/unix/process.c b/dlls/ntdll/unix/process.c
index a96b91a..3c39917 100644
--- a/dlls/ntdll/unix/process.c
+++ b/dlls/ntdll/unix/process.c
@@ -512,6 +512,10 @@ NTSTATUS WINAPI __wine_unix_spawnvp( char * const argv[], int wait )
     pid_t pid, wret;
     int fd[2], status, err;
 
+#ifdef __PROSPERO__
+    return STATUS_NOT_SUPPORTED;  /* no fork/exec in a PS5 title */
+#endif
+
 #ifdef HAVE_PIPE2
     if (pipe2( fd, O_CLOEXEC ) == -1)
 #endif
@@ -748,6 +752,13 @@ NTSTATUS WINAPI NtCreateUserProcess( HANDLE *process_handle_ptr, HANDLE *thread_
     data_size_t handles_size, jobs_size;
     obj_handle_t *handles, *jobs;
 
+#ifdef __PROSPERO__
+    /* A PS5 title is a single process: it can neither fork nor exec, so
+     * Windows process creation fails cleanly instead of spawning a loader. */
+    TRACE( "process creation is not supported on PS5\n" );
+    return STATUS_NOT_SUPPORTED;
+#endif
+
     if (thread_flags & THREAD_CREATE_FLAGS_HIDE_FROM_DEBUGGER)
     {
         WARN( "Invalid thread flags %#x.\n", thread_flags );
-- 
