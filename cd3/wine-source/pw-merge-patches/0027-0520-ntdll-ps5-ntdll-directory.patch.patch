From c2bd0c1ab5a8724f470c8b3119c59ab7af306a6e Mon Sep 17 00:00:00 2001
From: x <x@x>
Date: Thu, 5 Nov 2026 11:16:34 -0500
Subject: [PATCH 027/122] 0520-ntdll-ps5-ntdll-directory.patch

---
 dlls/ntdll/unix/loader.c | 8 ++++++++
 1 file changed, 8 insertions(+)

diff --git a/dlls/ntdll/unix/loader.c b/dlls/ntdll/unix/loader.c
index ebfb6af..4bba434 100644
--- a/dlls/ntdll/unix/loader.c
+++ b/dlls/ntdll/unix/loader.c
@@ -384,8 +384,16 @@ static void init_paths(void)
 {
     Dl_info info;
 
+#ifdef __PROSPERO__
+    /* A PS5 title loads ntdll as a PRX, which dladdr cannot name; the title
+     * passes the directory it loaded it from. */
+    if ((!dladdr( init_paths, &info ) || !(ntdll_dir = realpath_dirname( info.dli_fname ))) &&
+        !(ntdll_dir = getenv( "WINE_PS5_NTDLL_DIR" )))
+        fatal_error( "cannot get path to ntdll.so (set WINE_PS5_NTDLL_DIR)\n" );
+#else
     if (!dladdr( init_paths, &info ) || !(ntdll_dir = realpath_dirname( info.dli_fname )))
         fatal_error( "cannot get path to ntdll.so\n" );
+#endif
 
     if ((build_dir = remove_tail( ntdll_dir, "/dlls/ntdll" )))
     {
