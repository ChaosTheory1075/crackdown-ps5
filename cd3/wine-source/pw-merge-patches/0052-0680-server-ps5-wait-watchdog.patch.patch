diff --git a/server/queue.c b/server/queue.c
index b6cc920..51bb9ff 100644
--- a/server/queue.c
+++ b/server/queue.c
@@ -1312,6 +1312,45 @@ static void msg_queue_dump( struct object *obj, int verbose )
              queue_shm->wake_bits, queue_shm->wake_mask );
 }
 
+/* WINE_PS5_WAIT_WATCHDOG: a queue's wake state, pending messages, and the
+ * sent messages it waits for or has not answered. */
+void dump_queue_state( struct msg_queue *queue )
+{
+    queue_shm_t *shm = queue->shared;
+    struct message_result *res;
+    struct list *ptr;
+    unsigned int counts[NB_MSG_KINDS], i;
+
+    for (i = 0; i < NB_MSG_KINDS; i++)
+    {
+        counts[i] = 0;
+        LIST_FOR_EACH( ptr, &queue->msg_list[i] ) counts[i]++;
+    }
+    fprintf( stderr, "queue=%p bits=%x mask=%x changed=%x/%x sent=%u posted=%u",
+             queue, shm->wake_bits, shm->wake_mask, shm->changed_bits, shm->changed_mask,
+             counts[SEND_MESSAGE], counts[POST_MESSAGE] );
+    if ((ptr = list_head( &queue->send_result )))
+    {
+        res = LIST_ENTRY( ptr, struct message_result, sender_entry );
+        fprintf( stderr, " waits-reply msg=%04x win=%08x to=%p replied=%d",
+                 res->msg ? res->msg->msg : 0, res->msg ? res->msg->win : 0, res->receiver, res->replied );
+    }
+    if ((res = queue->recv_result))
+        fprintf( stderr, " handling msg=%04x win=%08x from=%p replied=%d",
+                 res->msg ? res->msg->msg : 0, res->msg ? res->msg->win : 0, res->sender, res->replied );
+    for (i = 0; i < NB_MSG_KINDS; i++)
+    {
+        struct message *msg;
+        unsigned int n = 0;
+        LIST_FOR_EACH_ENTRY( msg, &queue->msg_list[i], struct message, entry )
+        {
+            if (n++ == 3) break;
+            fprintf( stderr, " %s[%04x win=%08x]", i == SEND_MESSAGE ? "S" : "P", msg->msg, msg->win );
+        }
+    }
+    fprintf( stderr, "\n" );
+}
+
 static void msg_queue_destroy( struct object *obj )
 {
     struct msg_queue *queue = (struct msg_queue *)obj;
