 dlls/winevulkan/make_vulkan |  16 +++++-
 include/wine/vulkan.h       | 106 ++++++++++++++++++++++++++++++++++++
 2 files changed, 120 insertions(+), 2 deletions(-)

diff --git a/dlls/winevulkan/make_vulkan b/dlls/winevulkan/make_vulkan
index 71a921a..9840b2b 100755
--- a/dlls/winevulkan/make_vulkan
+++ b/dlls/winevulkan/make_vulkan
@@ -85,7 +85,6 @@ EXT_BLOCK_SIZE = 1000
 
 UNSUPPORTED_EXTENSIONS = {
     # Instance extensions
-    "VK_KHR_display", # Needs WSI work.
     "VK_KHR_surface_protected_capabilities",
     "VK_LUNARG_direct_driver_loading", # Implemented in the Vulkan loader
 
@@ -102,6 +101,16 @@ UNSUPPORTED_EXTENSIONS = {
     "VK_NV_external_compute_queue", # Has a new dispatchable handle
     "VK_NV_private_data_base_handle", # Questionable use case across wine boundary
 
+    # Built on VK_KHR_display, which only a host driver uses (below).
+    "VK_EXT_acquire_drm_display",
+    "VK_EXT_direct_mode_display",
+    "VK_EXT_display_control",
+    "VK_EXT_display_surface_counter",
+    "VK_KHR_display_swapchain",
+    "VK_KHR_get_display_properties2",
+    "VK_NV_acquire_winrt_display",
+    "VK_NV_display_stereo",
+
     # Extensions for other platforms
     "VK_EXT_metal_objects",
     "VK_GOOGLE_surfaceless_query",
@@ -125,6 +134,9 @@ UNSUPPORTED_EXTGROUPS = (
 UNEXPOSED_EXTENSIONS = {
     "VK_EXT_map_memory_placed",
     "VK_EXT_headless_surface",
+    # A host driver may present win32 surfaces through the display plane
+    # (the PS5's); applications still see only VK_KHR_win32_surface.
+    "VK_KHR_display",
     # Extensions for other platforms
     "VK_EXT_external_memory_dma_buf",
     "VK_EXT_image_drm_format_modifier",
@@ -842,7 +854,7 @@ class Function(Type):
         return body
 
     def spec(self, prefix=None, symbol=None):
-        if not self.is_required():
+        if not self.is_required() or not self.needs_exposing():
             return f"@ stub {self.name}\n"
 
         spec = ""
