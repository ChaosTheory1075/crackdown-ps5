From cface2c2eaba98ac3bab8404ebdd13749af49df9 Mon Sep 17 00:00:00 2001
From: x <x@x>
Date: Thu, 5 Nov 2026 11:16:37 -0500
Subject: [PATCH 079/122] 0889-ntdll-ps5-processor-times-from-the-process.patch

---
 dlls/ntdll/unix/system.c | 25 +++++++++++++++++++++++++
 1 file changed, 25 insertions(+)

diff --git a/dlls/ntdll/unix/system.c b/dlls/ntdll/unix/system.c
index 1b6ce90..b00bc59 100644
--- a/dlls/ntdll/unix/system.c
+++ b/dlls/ntdll/unix/system.c
@@ -3619,6 +3619,31 @@ NTSTATUS WINAPI NtQuerySystemInformation( SYSTEM_INFORMATION_CLASS class,
                 fclose(cpuinfo);
             }
         }
+#elif defined(__PROSPERO__)
+        {
+            /* A title cannot read the console's per-CPU counters (kern.cp_times is refused), and the
+             * title is the only user process it can see: each CPU is taken to have spent this
+             * process's CPU time evenly among the CPUs, and the rest of the time since the console
+             * started as idle. Idle time counts in the kernel time, as on Windows. */
+            struct timespec uptime;
+            struct rusage usage;
+            unsigned int n = min( peb->NumberOfProcessors, out_cpus );
+
+            if (n && !clock_gettime( CLOCK_MONOTONIC, &uptime ) && !getrusage( RUSAGE_SELF, &usage ))
+            {
+                ULONGLONG total = (ULONGLONG)uptime.tv_sec * 10000000 + uptime.tv_nsec / 100;
+                ULONGLONG user = ((ULONGLONG)usage.ru_utime.tv_sec * 1000000 + usage.ru_utime.tv_usec) * 10 / n;
+                ULONGLONG sys = ((ULONGLONG)usage.ru_stime.tv_sec * 1000000 + usage.ru_stime.tv_usec) * 10 / n;
+                ULONGLONG idle = total > user + sys ? total - user - sys : 0;
+
+                for (cpus = 0; cpus < n; cpus++)
+                {
+                    sppi[cpus].IdleTime.QuadPart = idle;
+                    sppi[cpus].KernelTime.QuadPart = sys + idle;
+                    sppi[cpus].UserTime.QuadPart = user;
+                }
+            }
+        }
 #elif defined(__FreeBSD__) || defined (__FreeBSD_kernel__)
         {
             static int clockrate_name[] = { CTL_KERN, KERN_CLOCKRATE };
-- 
