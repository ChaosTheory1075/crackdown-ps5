@@ -3898,6 +3835,49 @@ void virtual_init(void)
     else if (is_win64)
     {
         reserve_area( (void *)0x00010000, (void *)0x200000000 );
+#ifdef __PROSPERO__
+        /* [prospero-win 0570/0982, moved to Wine 11.20's virtual_init] no preloader on the console */
+        /* The high area, as large as the kernel grants below the address space
+         * limits, then room for the view heap wherever the kernel has space
+         * above 4 GiB (user space ends far below 0x7ffffe000000): after the
+         * high area, so that it cannot land inside the range the high area asks
+         * for. PW_PS5_HIGH_RESERVE_GB gives the first size tried, in GiB; 0 keeps
+         * the single 16 GiB reservation. */
+        {
+            void *heap = NULL, *high = NULL;
+            void *limit = min( user_space_limit, host_addr_space_limit );
+            const char *env = getenv( "PW_PS5_HIGH_RESERVE_GB" );
+            size_t want = PS5_HIGH_RESERVE_MAX, size;
+
+            if (env && *env) want = (size_t)min( strtoull( env, NULL, 10 ), 1ull << 20 ) << 30;  /* 1 PiB at most */
+            if (!want)
+            {
+                high = PS5_HIGH_BASE;
+                if (!sceKernelReserveVirtualRange( &high, PS5_HIGH_RESERVE, PS5_MAP_FIXED | PS5_MAP_NO_OVERWRITE,
+                                                   granularity_mask + 1 ))
+                    size = PS5_HIGH_RESERVE;
+                else size = 0;
+            }
+            else for (size = want; size; size = size > PS5_HIGH_RESERVE ? max( size / 2, PS5_HIGH_RESERVE ) : 0)
+            {
+                high = PS5_HIGH_BASE;
+                if ((char *)high + size > (char *)limit) continue;
+                if (!sceKernelReserveVirtualRange( &high, size, PS5_MAP_FIXED | PS5_MAP_NO_OVERWRITE,
+                                                   granularity_mask + 1 ))
+                {
+                    if (high == PS5_HIGH_BASE) break;
+                    munmap( high, size );  /* not where it was asked for */
+                }
+            }
+            if (size) set_mem_area_state( PS5_HIGH_BASE, size, AREA_RESERVED );
+            if (!sceKernelReserveVirtualRange( &heap, PS5_HEAP_RESERVE, 0, granularity_mask + 1 ))
+                set_mem_area_state( heap, PS5_HEAP_RESERVE, AREA_RESERVED );
+            else heap = NULL;
+            fprintf( stderr, "wine-ps5: address space: host limit %p, user limit %p, high area %p +%zu GiB "
+                     "(asked %zu GiB%s), heap area %p\n", host_addr_space_limit, user_space_limit,
+                     size ? PS5_HIGH_BASE : NULL, size >> 30, want >> 30, env && *env ? ", PW_PS5_HIGH_RESERVE_GB" : "", heap );
+        }
+#endif
     }
     else
     {
